# Copy to .env and edit. Never commit .env.
APP_ENV=development                 # production in real use (refuses to start with the default SECRET_KEY)
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECURE=0                     # 1 when served over HTTPS
BEHIND_PROXY=0                      # 1 behind nginx / a load balancer
PUBLIC_BASE_URL=                    # what phones open for QR codes, e.g. http://192.168.1.20:5000 (empty = the address you browsed to)

# --- database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elearning_db
DB_USER=lms_app                     # low-privilege login the web app uses (created by setup_db.py)
DB_PASSWORD=choose-a-strong-password
DB_APP_HOST=localhost               # host part of that login ('%' for Docker)
DB_POOL_SIZE=10
DB_ADMIN_USER=root                  # only used by setup_db.py / tests, never by the running app
DB_ADMIN_PASSWORD=

# --- behaviour ---
ATTENDANCE_THRESHOLD=75
QR_STEP_SECONDS=30                  # the QR code rotates this often
QR_ALLOWED_NETWORKS=                # optional: 10.0.0.0/8,192.168.0.0/16 -> only campus Wi-Fi can mark attendance
MAX_UPLOAD_MB=25
SESSION_HOURS=8
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MIN=15
UPLOAD_DIR=uploads
